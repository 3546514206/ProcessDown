# ===================================================
#             ProcessDown 环境变量配置
# ===================================================
# 注意：此文件包含敏感信息，绝对不能将真实信息提交到版本控制！
# ===================================================

# ----------------------------------------
# LLM API 配置（必需）
# ----------------------------------------

# API 基础地址（完整URL，包含协议和路径）
LLM_API_BASE_URL=https://api.openai.com/v1

# API 密钥
LLM_API_KEY=your-api-key-here

# 模型名称
LLM_MODEL=gpt-4o

# 最大生成 token 数（默认：2000。设为 -1 表示不限制,让模型自由生成到自然结束;
# 内网慢模型开启深度思考 <think> 时建议设 -1 或调大,否则思考会占满配额导致图表未输出）
LLM_MAX_TOKENS=-1

# LLM 请求超时,单位秒（默认：120。慢模型或不限制 token 时建议调大,如 300）
LLM_TIMEOUT=300

# ----------------------------------------
# 服务器配置（可选，有默认值）
# ----------------------------------------

# 服务器端口（默认：3000）
SERVER_PORT=3000

# 服务器监听地址（默认：0.0.0.0=所有网卡；内网建议绑特定IP或127.0.0.1配反代）
SERVER_HOST=0.0.0.0

# 请求超时时间，单位秒（默认：120）
REQUEST_TIMEOUT=120

# 健康检查是否探活 LLM（默认：false 关闭。内网慢模型建议关闭；开启时仅做 TCP 连通性检查，不发推理请求）
HEALTH_CHECK_LLM=false

# ----------------------------------------
# 安全配置（可选）
# ----------------------------------------

# 允许的 CORS 域名（多个用逗号分隔，不含通配符）
ALLOWED_ORIGINS=

# API 认证密钥（用于保护 API 接口）
API_AUTH_KEY=

# 日志级别：debug, info, warn, error（默认：info）
LOG_LEVEL=info

# Node 环境：development, production（默认：production）
NODE_ENV=production

# ----------------------------------------
# 会话配置（可选，有默认值）
# ----------------------------------------

# 单会话历史最大消息条数（默认：20 条 = 10 轮；超出后从最早的头部裁剪）
SESSION_MAX_HISTORY=20

# 旧全局会话目录 run/session/ 的保留天数（默认：7。启动时清理该目录下超期会话）。
# 注意：run/users/ 下的用户账号与历史会话永不自动清理，此项不影响用户数据。
SESSION_TTL_DAYS=7

# 登录 token 有效期，单位天（默认：7。设为 0 或负数表示永不过期；超过有效期后前端需重新登录）
AUTH_TOKEN_TTL_DAYS=7

# ⚠️ 安全前置：启用用户登录后，密码与 token 默认经 HTTP 明文传输，必须经 TLS
# 反代（HTTPS）访问，否则凭证可被中间人截获。公网部署强烈建议将 SERVER_HOST
# 绑定为 127.0.0.1，由前置 Nginx/Caddy 等终止 TLS 后反代到本服务。

# 会话存储目录：仅支持在 config/config.json 中配置 session.dir，默认 run/session